# Copy this file to .env and fill in values for your deployment.
# Never commit .env or production credentials.
PN_SONIC3DS_POSTGRES_URI=postgres://user:password@127.0.0.1:5432/sonic3ds?sslmode=disable
PN_SONIC3DS_AUTHENTICATION_SERVER_PORT=60000
PN_SONIC3DS_SECURE_SERVER_HOST=game.example.invalid
PN_SONIC3DS_SECURE_SERVER_PORT=60001
PN_SONIC3DS_ACCOUNT_GRPC_HOST=127.0.0.1
PN_SONIC3DS_ACCOUNT_GRPC_PORT=50051
PN_SONIC3DS_ACCOUNT_GRPC_API_KEY=replace-with-a-secret
PN_SONIC3DS_ACCESS_KEY=configure-the-game-access-key
# Optional. Defaults to 2.0.0 in the current implementation; this is unverified.
# PN_SONIC3DS_NEX_VERSION=2.0.0
# Optional. Enables extra protocol and PID logging.
# PN_SONIC3DS_VERBOSE_PACKET_LOGGING=1
